# PostgreSQL connection string. Use a NEW database on your existing server, e.g.:
# postgresql://USER:PASSWORD@localhost:5432/productsmanagement
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/productsmanagement"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-random-32-byte-secret"
NEXTAUTH_URL="http://localhost:3000"

# Base URL used to build links in emails (verification, password reset)
APP_URL="http://localhost:3000"

# Resend (transactional email — verification + password reset). Get a key at resend.com.
# Without this set, emails are logged to the server console instead of actually sent.
RESEND_API_KEY=""
# Must be on a domain you've verified in Resend, or leave unset to use their shared test address.
EMAIL_FROM="ProductDesk <onboarding@resend.dev>"

# Google OAuth (Sign in with Google). Create credentials at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: {NEXTAUTH_URL}/api/auth/callback/google
# Without these set, the Google sign-in button will error since no provider is configured.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
